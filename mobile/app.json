{
  "expo": {
    "name": "telefya-app",
    "slug": "telefya-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/telefya-logo.png",
    "scheme": "telefyapp",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Telefya needs camera access for video meetings.",
        "NSMicrophoneUsageDescription": "Telefya needs microphone access for audio meetings."
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/telefya-logo.png",
        "backgroundImage": "./assets/images/telefya-logo.png",
        "monochromeImage": "./assets/images/telefya-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.telefyaapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/telefya-logo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-audio",
      "expo-navigation-bar",
      "expo-secure-store",
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
